# Copy to .env and fill in. Never commit the real file.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=mysql+pymysql://store:store@localhost:3306/project_store?charset=utf8mb4
COOKIE_SECURE=false

# Razorpay test keys from https://dashboard.razorpay.com (Test mode). Leave empty to use the built-in practice gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RESERVATION_MINUTES=15

# Host port for the web container (docker compose). Change it if 8000 is taken.
WEB_PORT=8000
