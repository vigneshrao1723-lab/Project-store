# Copy to .env and fill in. Never commit the real file.
# SECRET_KEY: at least 32 random characters. The app refuses to start with this placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Used when you run the app outside Docker. Under docker compose the URL is built from DB_PASSWORD instead.
DATABASE_URL=mysql+pymysql://store:your-db-password@localhost:3306/project_store?charset=utf8mb4

# docker compose creates the MySQL accounts from these on the FIRST start of an empty database volume and refuses
# to start without them. Use two different long random values, for example from:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# They only apply when the volume is created; to change them later, change the passwords inside MySQL too.
DB_PASSWORD=
DB_ROOT_PASSWORD=
COOKIE_SECURE=false

# Razorpay test keys from https://dashboard.razorpay.com (Test mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# With no Razorpay keys the store takes no payments. Set this to true to use the built-in practice gateway
# (demos and local development only: any signed-in buyer can mark their own order paid for free).
ALLOW_PRACTICE_GATEWAY=false

RESERVATION_MINUTES=15

# First admin account, created by `flask seed` when there is no admin. Leave ADMIN_PASSWORD empty and a
# random password is generated and printed once in the seed output (docker compose logs web).
ADMIN_EMAIL=admin@projectstore.local
ADMIN_PASSWORD=

# Sign-in is blocked for LOGIN_LOCKOUT_MINUTES after LOGIN_MAX_ATTEMPTS failures from one email and IP.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10

# Host port for the web container (docker compose). Change it if 8000 is taken.
WEB_PORT=8000

# Contact details for the "Get in touch" block and /contact. Each is shown only when set; leave empty to hide it.
CONTACT_EMAIL=
# A phone number with the country code, e.g. +91 98xxxxxxxx. It also enables the WhatsApp chat button.
CONTACT_PHONE=
CONTACT_CITY=
# Full URLs, e.g. https://github.com/your-name
CONTACT_GITHUB=
CONTACT_LINKEDIN=

# Seller details on invoices. No tax line is shown unless SELLER_GSTIN is set.
SELLER_NAME=Project Store
SELLER_ADDRESS=
SELLER_GSTIN=

# The public address of the store, used for links inside order messages (invoice, setup guide, order page).
PUBLIC_BASE_URL=http://localhost:8000

# Order messages by email (see docs/NOTIFICATIONS.md). With a Gmail account: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USER=your address, SMTP_PASSWORD=an app password, SMTP_FROM=your address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Order messages by WhatsApp (Meta WhatsApp Cloud API, an approved template is required; see docs/NOTIFICATIONS.md).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_LANG=en
