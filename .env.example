# Copy to .env and fill in. Never commit the real file.
# SECRET_KEY: at least 32 random characters. The app refuses to start with this placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=mysql+pymysql://store:store@localhost:3306/project_store?charset=utf8mb4
COOKIE_SECURE=false

# Razorpay test keys from https://dashboard.razorpay.com (Test mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# With no Razorpay keys the store takes no payments. Set this to true to use the built-in practice gateway
# (demos and local development only: any signed-in buyer can mark their own order paid for free).
ALLOW_PRACTICE_GATEWAY=false

RESERVATION_MINUTES=15

# First admin account, created by `flask seed` when there is no admin. Leave ADMIN_PASSWORD empty and a
# random password is generated and printed once in the seed output (docker compose logs web).
ADMIN_EMAIL=admin@projectstore.local
ADMIN_PASSWORD=

# Sign-in is blocked for LOGIN_LOCKOUT_MINUTES after LOGIN_MAX_ATTEMPTS failures from one email and IP.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10

# Host port for the web container (docker compose). Change it if 8000 is taken.
WEB_PORT=8000
